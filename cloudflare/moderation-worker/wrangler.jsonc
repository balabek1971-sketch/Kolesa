{
  "$schema": "../../../node_modules/wrangler/config-schema.json",
  "name": "qazauto-media-moderation",
  "main": "src/index.js",
  "compatibility_date": "2026-09-09",
  "workers_dev": true,
  "ai": {
    "binding": "AI"
  },
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "qazauto-media"
    }
  ],
  "queues": {
    "producers": [
      {
        "binding": "MODERATION_QUEUE",
        "queue": "qazauto-media-moderation"
      }
    ],
    "consumers": [
      {
        "queue": "qazauto-media-moderation",
        "dead_letter_queue": "qazauto-media-moderation-dlq",
        "max_batch_size": 5,
        "max_batch_timeout": 5,
        "max_retries": 10,
        "retry_delay": 30
      }
    ]
  },
  "vars": {
    "API_BASE_URL": "https://kolesa-production.up.railway.app",
    "MODERATION_MAX_ATTEMPTS": "5",
    "VIDEO_MAX_ATTEMPTS": "10",
    "VEHICLE_CONFIDENCE": "0.55",
    "VIDEO_REQUIRED_FRAMES": "2"
  }
}
